# Contact Form SMTP Configuration
GMAIL_APP_PASSWORD=your_gmail_app_password

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Vapi voice agent (browser calls)
# Public key is safe in the browser - it is what the web SDK authenticates with.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=11c4d4b9-1f3f-4c2e-b140-7430ac8a51f2

# Server-only. NEVER prefix this with NEXT_PUBLIC_ - it can create calls and read transcripts.
VAPI_PRIVATE_KEY=your_vapi_private_key
